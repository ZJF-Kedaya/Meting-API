# ===== 服务基础配置 =====
# API 服务的公网访问地址（用于生成回调 URL，Vercel 上填你的部署域名）
METING_URL=https://your-domain.vercel.app
# HMAC 签名密钥（敏感接口 lrc/url/pic 鉴权用，请改为随机字符串）
METING_TOKEN=change-me-to-a-random-secret

# ===== HTTP 配置（本地 / Docker 用，Vercel 可忽略）=====
HTTP_PREFIX=
HTTP_PORT=80

# ===== Cookie 配置（QQ音乐等需要登录态的平台）=====
# 方式一（推荐，Vercel 上用此方式）：直接填到 Vercel 环境变量里
# 注意：变量名格式为 METING_COOKIE_大写平台名
METING_COOKIE_TENCENT=
METING_COOKIE_NETEASE=
METING_COOKIE_KUGOU=
METING_COOKIE_BAIDU=
METING_COOKIE_KUWO=

# 允许使用 cookie 的 referrer 域名白名单（逗号分隔，留空=不限制）
METING_COOKIE_ALLOW_HOSTS=

# ===== HTTPS 配置（仅本地 / Docker 用，Vercel 自带 HTTPS）=====
HTTPS_ENABLED=false
HTTPS_PORT=443
SSL_KEY_PATH=
SSL_CERT_PATH=
